# PostgreSQL bağlantısı. db/kurulum.sql ile oluşturulan "iz" kullanıcısının şifresini yazın.
# Şifrede özel karakter varsa URL kodlaması gerekir (ör. @ → %40).
DATABASE_URL=postgres://iz:SIFRE_BURAYA@localhost:5432/iz_dev

# TMDB (film/dizi araması) — isteğe bağlı. Boş bırakılırsa film/dizi araması nazikçe kapanır.
# https://www.themoviedb.org/settings/api adresinden "API Key" (v3) ya da "Read Access Token" (v4) alınabilir.
TMDB_ANAHTARI=

# Örnek veri (npm run db:seed) için demo hesaplarının şifresi. Yalnızca yerel geliştirme içindir.
SEED_SIFRE=iz-demo-2026
