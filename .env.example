# PostgreSQL bağlantısı. db/kurulum.sql ile oluşturulan "iz" kullanıcısının şifresini yazın.
# Şifrede özel karakter varsa URL kodlaması gerekir (ör. @ → %40).
DATABASE_URL=postgres://iz:SIFRE_BURAYA@localhost:5432/iz_dev

# TMDB (film/dizi araması) — isteğe bağlı. Boş bırakılırsa film/dizi araması nazikçe kapanır.
# https://www.themoviedb.org/settings/api adresinden "API Key" (v3) ya da "Read Access Token" (v4) alınabilir.
TMDB_ANAHTARI=

# Örnek veri (npm run db:seed) için demo hesaplarının şifresi. Yalnızca yerel geliştirme içindir.
SEED_SIFRE=iz-demo-2026

# Üretimde (npm start) istek gövdesi sınırı. Varsayılan 512K; JSON içe aktarma (5 MB), fotoğraf (15 MB)
# ve sesli yanıt (25 MB) için artırıldı.
BODY_SIZE_LIMIT=30M

# KVKK aydınlatma metni (/gizlilik): veri sorumlusu ve başvuru adresi. Boşsa genel ifade kullanılır.
VERI_SORUMLUSU=
ILETISIM_EPOSTA=

# Yüklenen fotoğraf ve seslerin klasörü (varsayılan ~/.iz/yuklemeler). Yayında kalıcı bir diske verin.
# YUKLEME_KLASORU=/var/lib/iz/yuklemeler
# Yerel yazıya dökme araçları (varsayılan ~/.iz/araclar; ayrıntı README).
# IZ_ARACLAR=/opt/iz/araclar
